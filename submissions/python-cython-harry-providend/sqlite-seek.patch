+/*
+** The integer key of cell idx on the table leaf page pPage.
+*/
+static int tableLeafKey(MemPage *pPage, int idx, i64 *pKey){
+  u8 *pCell = findCellPastPtr(pPage, idx);
+  while( 0x80 <= *(pCell++) ){
+    if( pCell>=pPage->aDataEnd ) return SQLITE_CORRUPT_PAGE(pPage);
+  }
+  getVarint(pCell, (u64*)pKey);
+  return SQLITE_OK;
+}
+
